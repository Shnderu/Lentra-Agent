import time
from core.engine.repository import fetch_tasks, mark_done, mark_failed


def run_worker():
    print(">>> WORKER STARTED")

    while True:
        try:
            tasks = fetch_tasks("worker", limit=3)

            for task in tasks:
                task_id, task_type, payload, retries = task

                print("EXEC:", task_type)

                			iiimark_done(task_id)

        except Exception as e:
            print("worker error:", e)

        time.sleep(1)


if __name__ == "__main__":
    run_worker()
